@model LoginViewModel

@{
    ViewData["Title"] = "Connexion";
    Layout = null;
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Connexion - NOVEC Gestion des Plans d'Action</title>
    <style>
        :root {
            --primary-color: #2a5298;
            --primary-dark: #1e2d4a;
            --secondary-color: #ff6b6b;
            --text-primary: #2c3e50;
            --text-secondary: #7f8c8d;
            --border-color: #e0e0e0;
            --light-bg: #f8f9fa;
            --success-color: #27ae60;
            --danger-color: #e74c3c;
            --warning-color: #f39c12;
            --info-color: #3498db;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
            width: 100%;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background: linear-gradient(135deg, var(--primary-dark) 0%, var(--primary-color) 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .login-wrapper {
            display: flex;
            gap: 0;
            max-width: 900px;
            width: 100%;
            background: white;
            border-radius: 10px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            overflow: hidden;
            min-height: 500px;
        }

        .login-banner {
            background: linear-gradient(135deg, var(--primary-dark) 0%, var(--primary-color) 100%);
            color: white;
            padding: 40px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            flex: 1;
        }

        .banner-icon {
            font-size: 3rem;
            margin-bottom: 20px;
        }

        .banner-title {
            font-size: 1.8rem;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .banner-subtitle {
            font-size: 0.95rem;
            opacity: 0.9;
        }

        .login-form-section {
            flex: 1;
            padding: 40px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .form-header {
            margin-bottom: 30px;
            text-align: center;
        }

        .form-title {
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 5px;
        }

        .form-subtitle {
            font-size: 0.9rem;
            color: var(--text-secondary);
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-label {
            display: block;
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 8px;
            font-size: 0.95rem;
        }

        .form-control {
            width: 100%;
            padding: 12px 14px;
            font-size: 1rem;
            border: 1px solid var(--border-color);
            border-radius: 6px;
            transition: all 0.3s ease;
            font-family: inherit;
        }

        .form-control:focus {
            outline: none;
            border-color: var(--primary-color);
            box-shadow: 0 0 0 3px rgba(42, 82, 152, 0.1);
        }

        .form-control::placeholder {
            color: #999;
        }

        .checkbox-group {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 20px;
        }

        .checkbox-input {
            width: 18px;
            height: 18px;
            cursor: pointer;
            accent-color: var(--primary-color);
        }

        .checkbox-label {
            font-size: 0.95rem;
            color: var(--text-primary);
            cursor: pointer;
        }

        .btn-login {
            width: 100%;
            padding: 12px 16px;
            background-color: var(--secondary-color);
            color: white;
            border: none;
            border-radius: 6px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-bottom: 15px;
        }

        .btn-login:hover {
            background-color: #ff5252;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(255, 107, 107, 0.3);
        }

        .btn-login:active {
            transform: translateY(0);
        }

        .alert {
            padding: 12px 16px;
            border-radius: 6px;
            margin-bottom: 20px;
            border-left: 4px solid;
        }

        .alert-info {
            background-color: #e3f2fd;
            border-left-color: var(--info-color);
            color: #1565c0;
        }

        .alert-danger {
            background-color: #ffebee;
            border-left-color: var(--danger-color);
            color: #c62828;
        }

        .demo-credentials {
            background-color: #f8f9fa;
            padding: 15px 14px;
            border-radius: 6px;
            border: 1px solid var(--border-color);
            margin-bottom: 20px;
            font-size: 0.85rem;
        }

        .demo-credentials-title {
            font-weight: 600;
            color: var(--primary-color);
            margin-bottom: 8px;
        }

        .demo-credentials-item {
            display: flex;
            justify-content: space-between;
            padding: 4px 0;
            color: var(--text-secondary);
            font-family: 'Courier New', monospace;
            font-size: 0.8rem;
        }

        .demo-credentials-role {
            font-weight: 600;
            color: var(--text-primary);
        }

        .footer-links {
            text-align: center;
            margin-top: 20px;
        }

        .footer-link {
            color: var(--primary-color);
            text-decoration: none;
            font-size: 0.9rem;
            transition: color 0.3s ease;
        }

        .footer-link:hover {
            color: var(--primary-dark);
            text-decoration: underline;
        }

        .error-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .error-list li {
            padding: 4px 0;
        }

        .error-list li::before {
            content: "✕ ";
            font-weight: 700;
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .login-wrapper {
                flex-direction: column;
                min-height: auto;
            }

            .login-banner {
                padding: 30px 20px;
                min-height: 150px;
            }

            .banner-icon {
                font-size: 2.5rem;
                margin-bottom: 15px;
            }

            .banner-title {
                font-size: 1.5rem;
            }

            .login-form-section {
                padding: 30px 20px;
            }

            .form-title {
                font-size: 1.5rem;
            }
        }

        @@media (max-width: 480px) {
            .login-banner {
                padding: 20px;
            }

            .login-form-section {
                padding: 20px;
            }

            .form-header {
                margin-bottom: 20px;
            }

            .demo-credentials {
                padding: 12px;
                font-size: 0.8rem;
            }

            .demo-credentials-item {
                flex-direction: column;
                gap: 2px;
            }
        }
    </style>
</head>
<body>
    <div class="login-wrapper">
        <!-- Banner Section -->
        <div class="login-banner">
            <div class="banner-icon">🔐</div>
            <h2 class="banner-title">Bienvenue</h2>
            <p class="banner-subtitle">Plateforme de Gestion des Plans d'Action NOVEC</p>
        </div>

        <!-- Form Section -->
        <div class="login-form-section">
            <div class="form-header">
                <h1 class="form-title">Connexion</h1>
                <p class="form-subtitle">Accédez à votre espace personnel</p>
            </div>

            @if (ViewBag.ReturnUrl != null)
            {
                <div class="alert alert-info">
                    ℹ️ Connexion requise pour accéder à cette page
                </div>
            }

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Any()))
            {
                <div class="alert alert-danger">
                    <ul class="error-list">
                        @foreach (var modelState in ViewData.ModelState.Values)
                        {
                            @foreach (var error in modelState.Errors)
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        }
                    </ul>
                </div>
            }

            <div class="demo-credentials">
                <div class="demo-credentials-title">📋 Identifiants de test :</div>
                <div class="demo-credentials-item">
                    <span class="demo-credentials-role">Admin:</span>
                    <span>admin@novec.fr / Test@12345</span>
                </div>
                <div class="demo-credentials-item">
                    <span class="demo-credentials-role">Gestionnaire:</span>
                    <span>gestionnaire@novec.fr / Test@12345</span>
                </div>
                <div class="demo-credentials-item">
                    <span class="demo-credentials-role">Responsable:</span>
                    <span>responsable@novec.fr / Test@12345</span>
                </div>
            </div>

            <form method="post">
                <div class="form-group">
                    <label for="email" class="form-label">📧 Adresse Email</label>
                    <input type="email" class="form-control" id="email" name="Email"
                           placeholder="Votre adresse email" required value="@Model?.Email" />
                </div>

                <div class="form-group">
                    <label for="password" class="form-label">🔑 Mot de passe</label>
                    <input type="password" class="form-control" id="password" name="Password"
                           placeholder="Votre mot de passe" required />
                </div>

                <div class="checkbox-group">
                    <input type="checkbox" class="checkbox-input" id="rememberMe" name="RememberMe" />
                    <label class="checkbox-label" for="rememberMe">Se souvenir de moi</label>
                </div>

                <button type="submit" class="btn-login">✓ Se connecter</button>
            </form>

            <div class="footer-links">
                <a href="@Url.Action("Index", "Home")" class="footer-link">← Retour à l'accueil</a>
            </div>
        </div>
    </div>
</body>
</html>
