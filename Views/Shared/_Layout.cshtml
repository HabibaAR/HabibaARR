@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NOVEC Plans d'Action</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="d-flex">
        <!-- Sidebar -->
        @if (SignInManager.IsSignedIn(User))
        {
            <nav class="sidebar bg-dark text-white p-3">
                <div class="sidebar-brand mb-4">
                    <h5 class="mb-0">
                        <i class="fas fa-tasks"></i> NOVEC
                    </h5>
                </div>

                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link text-white" asp-controller="Dashboard" asp-action="Index">
                            <i class="fas fa-chart-line"></i> Tableau de bord
                        </a>
                    </li>
                    @if (User.IsInRole("ADMIN") || User.IsInRole("DIRECTEUR") || User.IsInRole("GESTIONNAIRE"))
                    {
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="ActionPlans" asp-action="Index">
                                <i class="fas fa-file-alt"></i> Plans d'action
                            </a>
                        </li>
                    }
                    @if (User.IsInRole("RESPONSABLE") || User.IsInRole("GESTIONNAIRE"))
                    {
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Actions" asp-action="Index">
                                <i class="fas fa-tasks"></i> Actions
                            </a>
                        </li>
                    }
                </ul>

                <hr class="bg-white" />

                <div class="user-info">
                    <p class="mb-2 small">
                        Connecté en tant que:
                    </p>
                    <p class="mb-3">
                        <strong>@User.FindFirst("name")?.Value</strong>
                    </p>
                    <form method="post" asp-controller="Account" asp-action="Logout" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-light">
                            <i class="fas fa-sign-out-alt"></i> Déconnexion
                        </button>
                    </form>
                </div>
            </nav>
        }

        <!-- Main Content -->
        <main class="main-content flex-grow-1">
            @if (SignInManager.IsSignedIn(User))
            {
                <header class="navbar navbar-expand-lg navbar-light bg-light border-bottom">
                    <div class="container-fluid">
                        <span class="navbar-text ms-3">
                            Plateforme de Gestion des Plans d'Action - NOVEC Group
                        </span>
                    </div>
                </header>
            }

            <div class="container-fluid p-4">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @RenderBody()
            </div>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
