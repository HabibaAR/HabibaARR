@model ActionPlanViewModel

@{
    ViewData["Title"] = $"Plan: {Model.Title}";
}

<style>
    .plan-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 30px;
        gap: 20px;
    }

    .plan-title-section h1 {
        font-size: 2rem;
        font-weight: 700;
        color: var(--text-primary);
        margin: 0 0 8px 0;
    }

    .plan-reference {
        color: var(--text-secondary);
        font-size: 0.95rem;
    }

    .status-badge-plan {
        display: inline-block;
        padding: 8px 16px;
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.9rem;
    }

    .plan-layout {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 20px;
        margin-bottom: 30px;
    }

    .plan-card {
        background: white;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        overflow: hidden;
    }

    .plan-card-header {
        background: var(--light-bg);
        border-bottom: 2px solid var(--border-color);
        padding: 16px 20px;
        font-weight: 600;
        color: var(--text-primary);
        font-size: 1.05rem;
    }

    .plan-card-body {
        padding: 20px;
    }

    .info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-top: 15px;
    }

    .info-item {
        padding: 12px;
        background: var(--light-bg);
        border-radius: 6px;
    }

    .info-label {
        font-size: 0.85rem;
        color: var(--text-secondary);
        font-weight: 600;
        margin-bottom: 4px;
    }

    .info-value {
        color: var(--text-primary);
        font-size: 0.95rem;
    }

    .action-count-badge {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 12px;
        background: #e3f2fd;
        color: #1565c0;
        font-weight: 600;
        font-size: 0.9rem;
    }

    .plan-buttons {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .plan-button {
        padding: 12px 16px;
        border: none;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
        text-align: center;
        transition: all 0.3s ease;
        font-size: 0.95rem;
        text-decoration: none;
        display: block;
    }

    .btn-submit {
        background: var(--success-color);
        color: white;
    }

    .btn-submit:hover {
        background: #229954;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(39, 174, 96, 0.3);
    }

    .btn-cancel {
        background: var(--text-secondary);
        color: white;
    }

    .btn-cancel:hover {
        background: #555;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(127, 140, 141, 0.3);
    }

    .btn-add {
        background: var(--primary-color);
        color: white;
    }

    .btn-add:hover {
        background: #1e3e7d;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(42, 82, 152, 0.3);
    }

    .btn-view-actions {
        padding: 12px 16px;
        background: var(--light-bg);
        color: var(--primary-color);
        text-decoration: none;
        border-radius: 6px;
        font-weight: 600;
        transition: all 0.3s ease;
        display: block;
        text-align: center;
    }

    .btn-view-actions:hover {
        background: #e8f4f8;
    }

    .back-button {
        display: inline-block;
        padding: 10px 16px;
        background: var(--light-bg);
        color: var(--primary-color);
        text-decoration: none;
        border-radius: 6px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .back-button:hover {
        background: #e8f4f8;
    }

    .description-text {
        color: var(--text-primary);
        line-height: 1.6;
        margin-bottom: 15px;
    }

    /* Status Colors */
    .status-draft { background: #9e9e9e; color: white; }
    .status-active { background: #c8e6c9; color: #1b5e20; }
    .status-closed { background: #616161; color: white; }
    .status-archived { background: #fff3e0; color: #e65100; }

    @media (max-width: 1024px) {
        .plan-layout {
            grid-template-columns: 1fr;
        }

        .info-grid {
            grid-template-columns: 1fr;
        }

        .plan-header {
            flex-direction: column;
        }
    }

    @media (max-width: 768px) {
        .plan-header {
            flex-direction: column;
        }

        .plan-layout {
            grid-template-columns: 1fr;
        }

        .plan-title-section h1 {
            font-size: 1.5rem;
        }
    }
</style>

<div class="plan-header">
    <div class="plan-title-section">
        <h1>@Model.Title</h1>
        <p class="plan-reference">Référence: <strong>@Model.Reference</strong></p>
    </div>
    <span class="status-badge-plan @GetStatusClass(Model.Status)">
        @GetStatusDisplay(Model.Status)
    </span>
</div>

<div class="plan-layout">
    <!-- Left Column: Information -->
    <div>
        <div class="plan-card">
            <div class="plan-card-header">ℹ️ Informations du plan</div>
            <div class="plan-card-body">
                <p class="description-text">@Model.Description</p>

                <div class="info-grid">
                    <div class="info-item">
                        <div class="info-label">Gestionnaire</div>
                        <div class="info-value">@Model.ManagerName</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Nombre d'actions</div>
                        <span class="action-count-badge">@Model.ActionCount</span>
                    </div>
                </div>

                <div class="info-grid">
                    <div class="info-item">
                        <div class="info-label">Date de début</div>
                        <div class="info-value">@Model.StartDate.ToShortDateString()</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Date de fin</div>
                        <div class="info-value">@Model.EndDate.ToShortDateString()</div>
                    </div>
                </div>

                <div class="info-grid">
                    <div class="info-item">
                        <div class="info-label">Créé le</div>
                        <div class="info-value">@Model.CreatedAt.ToString("g")</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Mis à jour</div>
                        <div class="info-value">@(Model.UpdatedAt?.ToString("g") ?? "Jamais")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column: Actions -->
    <div>
        <div class="plan-card">
            <div class="plan-card-header">⚡ Actions</div>
            <div class="plan-card-body">
                <div class="plan-buttons">
                    @if (Model.Status == ActionPlanStatus.Draft)
                    {
                        <form asp-action="Submit" asp-route-id="@Model.Id" method="post">
                            <button type="submit" class="plan-button btn-submit" onclick="return confirm('Êtes-vous sûr de vouloir transmettre ce plan ?')">
                                📤 Transmettre le plan
                            </button>
                        </form>
                        <a asp-action="Index" class="plan-button btn-cancel">✕ Annuler</a>
                    }
                    else
                    {
                        <a asp-controller="Actions" asp-action="Create" asp-route-planId="@Model.Id" class="plan-button btn-add">
                            ✚ Ajouter une action
                        </a>
                    }
                </div>
            </div>
        </div>

        <div class="plan-card" style="margin-top: 20px;">
            <div class="plan-card-header">✓ Actions (@Model.ActionCount)</div>
            <div class="plan-card-body">
                <a asp-controller="Actions" asp-action="Index" asp-route-planId="@Model.Id" class="btn-view-actions">
                    Voir toutes les actions →
                </a>
            </div>
        </div>
    </div>
</div>

<a asp-action="Index" class="back-button">← Retour à la liste</a>

@functions {
    string GetStatusClass(ActionPlanStatus status)
    {
        return status switch
        {
            ActionPlanStatus.Draft => "status-draft",
            ActionPlanStatus.Active => "status-active",
            ActionPlanStatus.Closed => "status-closed",
            ActionPlanStatus.Archived => "status-archived",
            _ => "status-draft"
        };
    }

    string GetStatusDisplay(ActionPlanStatus status)
    {
        return status switch
        {
            ActionPlanStatus.Draft => "🔨 Brouillon",
            ActionPlanStatus.Active => "✓ Actif",
            ActionPlanStatus.Closed => "✓✓ Clôturé",
            ActionPlanStatus.Archived => "📦 Archivé",
            _ => "? Inconnu"
        };
    }
}
