@model CreateActionPlanViewModel

@{
    ViewData["Title"] = "Créer un plan d'action";
}

<style>
    .create-page-title {
        font-size: 2rem;
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 30px;
    }

    .create-layout {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 20px;
        margin-bottom: 20px;
    }

    .form-card {
        background: white;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        padding: 24px;
    }

    .form-group {
        margin-bottom: 18px;
    }

    .form-label {
        display: block;
        font-weight: 600;
        color: var(--text-primary);
        margin-bottom: 6px;
        font-size: 0.9rem;
    }

    .form-control {
        width: 100%;
        padding: 10px 12px;
        border: 1px solid var(--border-color);
        border-radius: 6px;
        font-family: inherit;
        font-size: 0.95rem;
        transition: all 0.3s ease;
        box-sizing: border-box;
    }

    .form-control:focus {
        outline: none;
        border-color: var(--primary-color);
        box-shadow: 0 0 0 3px rgba(42, 82, 152, 0.1);
    }

    .form-hint {
        font-size: 0.8rem;
        color: var(--text-secondary);
        margin-top: 4px;
    }

    .form-error {
        font-size: 0.8rem;
        color: var(--danger-color);
        margin-top: 4px;
        display: block;
    }

    .date-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    textarea.form-control {
        resize: vertical;
        min-height: 120px;
    }

    .info-box {
        background: #e3f2fd;
        border-left: 4px solid var(--info-color);
        padding: 16px;
        border-radius: 6px;
        margin-bottom: 20px;
        font-size: 0.9rem;
        color: #1565c0;
    }

    .info-box strong {
        color: var(--text-primary);
    }

    .button-group {
        display: flex;
        gap: 12px;
        margin-top: 24px;
    }

    .submit-button {
        background: var(--primary-color);
        color: white;
        padding: 12px 24px;
        border: none;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        font-size: 0.95rem;
    }

    .submit-button:hover {
        background: #1e3e7d;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(42, 82, 152, 0.3);
    }

    .cancel-button {
        background: var(--text-secondary);
        color: white;
        padding: 12px 24px;
        border: none;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        font-size: 0.95rem;
        text-decoration: none;
        display: inline-block;
    }

    .cancel-button:hover {
        background: #555;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(127, 140, 141, 0.3);
    }

    .tips-card {
        background: white;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        overflow: hidden;
    }

    .tips-header {
        background: var(--light-bg);
        border-bottom: 2px solid var(--border-color);
        padding: 16px 20px;
        font-weight: 600;
        color: var(--text-primary);
    }

    .tips-body {
        padding: 20px;
        font-size: 0.9rem;
        color: var(--text-secondary);
        line-height: 1.8;
    }

    .tips-body ul {
        margin: 0;
        padding-left: 20px;
    }

    .tips-body li {
        margin-bottom: 10px;
    }

    .tips-body strong {
        color: var(--text-primary);
    }

    @media (max-width: 1024px) {
        .create-layout {
            grid-template-columns: 1fr;
        }

        .date-grid {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 768px) {
        .create-page-title {
            font-size: 1.5rem;
        }

        .button-group {
            flex-direction: column;
        }

        .submit-button,
        .cancel-button {
            width: 100%;
        }
    }
</style>

<h1 class="create-page-title">✚ Créer un nouveau plan d'action</h1>

<div class="create-layout">
    <form asp-action="Create" method="post">
        <div class="form-card">
            <div class="form-group">
                <label asp-for="Reference" class="form-label">Référence *</label>
                <input asp-for="Reference" class="form-control" placeholder="PAC-2026-001" required />
                <span asp-validation-for="Reference" class="form-error"></span>
                <div class="form-hint">Format : PAC-AAAA-NNN</div>
            </div>

            <div class="form-group">
                <label asp-for="Title" class="form-label">Intitulé *</label>
                <input asp-for="Title" class="form-control" placeholder="Titre du plan" required />
                <span asp-validation-for="Title" class="form-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description" class="form-label">Description</label>
                <textarea asp-for="Description" class="form-control" placeholder="Détails du plan..."></textarea>
                <span asp-validation-for="Description" class="form-error"></span>
            </div>

            <div class="date-grid">
                <div class="form-group">
                    <label asp-for="StartDate" class="form-label">Date de début *</label>
                    <input asp-for="StartDate" class="form-control" type="date" required />
                    <span asp-validation-for="StartDate" class="form-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="EndDate" class="form-label">Date de fin *</label>
                    <input asp-for="EndDate" class="form-control" type="date" required />
                    <span asp-validation-for="EndDate" class="form-error"></span>
                </div>
            </div>

            <div class="info-box">
                ℹ️ <strong>Information:</strong> Le plan sera créé en <strong>Brouillon</strong>. Vous pourrez le modifier avant transmission.
            </div>

            <div class="button-group">
                <button type="submit" class="submit-button">✓ Créer le plan</button>
                <a asp-action="Index" class="cancel-button">✕ Annuler</a>
            </div>
        </div>
    </form>

    <div class="tips-card">
        <div class="tips-header">💡 Conseils</div>
        <div class="tips-body">
            <ul>
                <li>Utilisez une <strong>référence unique</strong></li>
                <li>Donnez un titre <strong>explicite</strong></li>
                <li>Décrivez le contexte et les objectifs</li>
                <li>Fixez des dates <strong>réalistes</strong></li>
                <li>Vous ajouterez les actions <strong>après création</strong></li>
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
