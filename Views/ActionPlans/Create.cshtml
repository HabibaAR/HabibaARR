@model CreateActionPlanViewModel

@{
    ViewData["Title"] = "Créer un plan d'action";
}

<div class="container">
    <h1 class="mb-4">
        <i class="fas fa-plus-circle"></i> Créer un nouveau plan d'action
    </h1>

    <form asp-action="Create" method="post" class="row">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Reference" class="form-label">Référence *</label>
                        <input asp-for="Reference" class="form-control" placeholder="PAC-2026-001" required />
                        <span asp-validation-for="Reference" class="text-danger small"></span>
                        <small class="text-muted">Format : PAC-AAAA-NNN</small>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label">Intitulé *</label>
                        <input asp-for="Title" class="form-control" placeholder="Titre du plan" required />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="5" placeholder="Détails du plan..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="StartDate" class="form-label">Date de début *</label>
                                <input asp-for="StartDate" class="form-control" type="date" required />
                                <span asp-validation-for="StartDate" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="EndDate" class="form-label">Date de fin *</label>
                                <input asp-for="EndDate" class="form-control" type="date" required />
                                <span asp-validation-for="EndDate" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-info">
                        <i class="fas fa-info-circle"></i>
                        <strong>Info :</strong> Le plan sera créé en <strong>Brouillon</strong>.
                        Vous pourrez le modifier avant transmission.
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save"></i> Créer le plan
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-times"></i> Annuler
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card bg-light">
                <div class="card-header">
                    <h5 class="mb-0">Conseils</h5>
                </div>
                <div class="card-body small">
                    <ul>
                        <li>Utilisez une <strong>référence unique</strong></li>
                        <li>Donnez un titre <strong>explicite</strong></li>
                        <li>Décrivez le contexte et les objectifs</li>
                        <li>Fixez des dates <strong>réalistes</strong></li>
                        <li>Vous ajouterez les actions <strong>après création</strong></li>
                    </ul>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
