@model IEnumerable<ActionPlanViewModel>

@{
    ViewData["Title"] = "Plans d'action";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>
            <i class="fas fa-file-alt"></i> Plans d'action
        </h1>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus"></i> Nouveau plan
        </a>
    </div>

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Référence</th>
                        <th>Intitulé</th>
                        <th>Gestionnaire</th>
                        <th>Statut</th>
                        <th>Actions</th>
                        <th>Dates</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var plan in Model.OrderByDescending(p => p.CreatedAt))
                    {
                        <tr>
                            <td>
                                <strong>@plan.Reference</strong>
                            </td>
                            <td>@plan.Title</td>
                            <td>@plan.ManagerName</td>
                            <td>
                                <span class="badge @GetStatusBadgeClass(plan.Status)">
                                    @GetStatusDisplay(plan.Status)
                                </span>
                            </td>
                            <td>
                                <span class="badge bg-info">@plan.ActionCount</span>
                            </td>
                            <td>
                                <small>
                                    @plan.StartDate.ToShortDateString() - @plan.EndDate.ToShortDateString()
                                </small>
                            </td>
                            <td class="text-center">
                                <a asp-action="Details" asp-route-id="@plan.Id" class="btn btn-sm btn-info">
                                    <i class="fas fa-eye"></i>
                                </a>
                                @if (plan.Status == ActionPlanStatus.Draft)
                                {
                                    <form asp-action="Submit" asp-route-id="@plan.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-success"
                                                onclick="return confirm('Confirmer la transmission du plan ?')">
                                            <i class="fas fa-paper-plane"></i>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            <i class="fas fa-info-circle"></i> Aucun plan d'action trouvé.
            <a asp-action="Create">Créer le premier plan</a>
        </div>
    }
</div>

@functions {
    string GetStatusBadgeClass(ActionPlanStatus status)
    {
        return status switch
        {
            ActionPlanStatus.Draft => "bg-secondary",
            ActionPlanStatus.Active => "bg-success",
            ActionPlanStatus.Closed => "bg-dark",
            ActionPlanStatus.Archived => "bg-warning",
            _ => "bg-light"
        };
    }

    string GetStatusDisplay(ActionPlanStatus status)
    {
        return status switch
        {
            ActionPlanStatus.Draft => "Brouillon",
            ActionPlanStatus.Active => "Actif",
            ActionPlanStatus.Closed => "Clôturé",
            ActionPlanStatus.Archived => "Archivé",
            _ => "Inconnu"
        };
    }
}
