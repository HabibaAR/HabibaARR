@{
    ViewData["Title"] = "Accueil";
    Layout = null;
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Plateforme de Gestion des Plans d'Action - NOVEC</title>
    <style>
        :root {
            --primary-color: #2a5298;
            --primary-dark: #1e2d4a;
            --primary-light: #3d6bb8;
            --secondary-color: #ff6b6b;
            --success-color: #27ae60;
            --text-primary: #2c3e50;
            --text-secondary: #7f8c8d;
            --light-bg: #f8f9fa;
            --border-color: #e0e0e0;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
            width: 100%;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            color: var(--text-primary);
            line-height: 1.6;
        }

        /* Navigation */
        .public-nav {
            background: white;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
            padding: 0 40px;
            height: 70px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .nav-brand {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--primary-color);
            text-decoration: none;
            letter-spacing: 1px;
        }

        .nav-links {
            display: flex;
            gap: 20px;
            align-items: center;
        }

        .nav-link {
            text-decoration: none;
            color: var(--text-primary);
            transition: color 0.3s ease;
            padding: 8px 16px;
            border-radius: 4px;
        }

        .nav-link:hover {
            color: var(--primary-color);
            background-color: var(--light-bg);
        }

        .btn-login {
            background-color: var(--primary-color);
            color: white;
            padding: 10px 24px;
            border-radius: 4px;
            text-decoration: none;
            transition: background-color 0.3s ease;
        }

        .btn-login:hover {
            background-color: var(--primary-dark);
        }

        /* Hero Section */
        .hero-section {
            background: linear-gradient(135deg, var(--primary-dark) 0%, var(--primary-color) 100%);
            color: white;
            padding: 100px 40px;
            text-align: center;
            min-height: 500px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }

        .hero-logo {
            font-size: 4rem;
            margin-bottom: 30px;
        }

        .hero-title {
            font-size: 2.8rem;
            font-weight: 700;
            margin-bottom: 20px;
            line-height: 1.3;
        }

        .hero-subtitle {
            font-size: 1.2rem;
            margin-bottom: 40px;
            opacity: 0.95;
            max-width: 600px;
        }

        .hero-buttons {
            display: flex;
            gap: 15px;
            justify-content: center;
            flex-wrap: wrap;
        }

        .btn-primary {
            background-color: var(--secondary-color);
            color: white;
            padding: 12px 40px;
            border-radius: 4px;
            text-decoration: none;
            font-size: 1rem;
            font-weight: 600;
            transition: all 0.3s ease;
            border: none;
            cursor: pointer;
        }

        .btn-primary:hover {
            background-color: #ff5252;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(255, 107, 107, 0.3);
        }

        .btn-secondary {
            background-color: transparent;
            color: white;
            padding: 12px 40px;
            border: 2px solid white;
            border-radius: 4px;
            text-decoration: none;
            font-size: 1rem;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .btn-secondary:hover {
            background-color: white;
            color: var(--primary-dark);
        }

        /* Presentation Section */
        .presentation-section {
            padding: 60px 40px;
            background: white;
            max-width: 1200px;
            margin: 0 auto;
        }

        .section-title {
            font-size: 2rem;
            margin-bottom: 30px;
            color: var(--text-primary);
        }

        .presentation-text {
            font-size: 1.05rem;
            line-height: 1.8;
            color: var(--text-secondary);
            margin-bottom: 20px;
        }

        /* Features Section */
        .features-section {
            padding: 60px 40px;
            background-color: var(--light-bg);
        }

        .features-container {
            max-width: 1200px;
            margin: 0 auto;
        }

        .features-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 30px;
            margin-top: 40px;
        }

        .feature-card {
            background: white;
            padding: 30px;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
            text-align: center;
            transition: all 0.3s ease;
        }

        .feature-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);
        }

        .feature-icon {
            font-size: 2.5rem;
            margin-bottom: 15px;
        }

        .feature-title {
            font-size: 1.2rem;
            font-weight: 600;
            margin-bottom: 10px;
            color: var(--text-primary);
        }

        .feature-description {
            font-size: 0.95rem;
            color: var(--text-secondary);
            line-height: 1.6;
        }

        /* Workflow Section */
        .workflow-section {
            padding: 60px 40px;
            background: white;
        }

        .workflow-container {
            max-width: 1200px;
            margin: 0 auto;
        }

        .workflow-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 40px;
            margin-top: 40px;
        }

        .workflow-step {
            text-align: center;
            padding: 30px 20px;
            border-radius: 8px;
            background: var(--light-bg);
        }

        .workflow-number {
            display: inline-block;
            width: 50px;
            height: 50px;
            background-color: var(--primary-color);
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 1.5rem;
            margin-bottom: 15px;
        }

        .workflow-icon {
            font-size: 2rem;
            margin: 15px 0;
        }

        .workflow-title {
            font-size: 1.1rem;
            font-weight: 600;
            margin-bottom: 10px;
            color: var(--text-primary);
        }

        .workflow-description {
            font-size: 0.9rem;
            color: var(--text-secondary);
        }

        /* Footer */
        .public-footer {
            background: var(--primary-dark);
            color: white;
            padding: 40px;
            text-align: center;
        }

        .footer-content {
            max-width: 1200px;
            margin: 0 auto;
        }

        .footer-text {
            margin: 10px 0;
        }

        .footer-links {
            margin-top: 20px;
            padding-top: 20px;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
        }

        .footer-link {
            color: rgba(255, 255, 255, 0.8);
            text-decoration: none;
            margin: 0 15px;
            transition: color 0.3s ease;
        }

        .footer-link:hover {
            color: white;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .public-nav {
                padding: 0 20px;
                flex-wrap: wrap;
            }

            .nav-brand {
                font-size: 1.2rem;
            }

            .nav-links {
                gap: 10px;
                font-size: 0.9rem;
            }

            .hero-section {
                padding: 60px 20px;
                min-height: auto;
            }

            .hero-title {
                font-size: 2rem;
            }

            .hero-subtitle {
                font-size: 1rem;
            }

            .presentation-section,
            .features-section,
            .workflow-section,
            .public-footer {
                padding: 40px 20px;
            }

            .section-title {
                font-size: 1.5rem;
            }

            .features-grid,
            .workflow-grid {
                gap: 20px;
            }

            .btn-primary,
            .btn-secondary {
                padding: 10px 20px;
                font-size: 0.95rem;
            }
        }

        @media (max-width: 480px) {
            .public-nav {
                flex-direction: column;
                height: auto;
                gap: 10px;
                padding: 10px 15px;
            }

            .nav-links {
                width: 100%;
                justify-content: center;
            }

            .hero-logo {
                font-size: 2.5rem;
            }

            .hero-title {
                font-size: 1.5rem;
            }

            .features-grid,
            .workflow-grid {
                grid-template-columns: 1fr;
            }

            .footer-links {
                display: flex;
                flex-direction: column;
                gap: 10px;
            }

            .footer-link {
                margin: 0;
            }
        }
    </style>
</head>
<body>
    <!-- Navigation -->
    <nav class="public-nav">
        <a href="/" class="nav-brand">
            <img src="/images/novec-logo.svg" alt="NOVEC Logo" style="height: 50px; width: auto;">
        </a>
        <div class="nav-links">
            <a href="@Url.Action("Index", "Home")" class="nav-link">Accueil</a>
            <a href="@Url.Action("Login", "Account")" class="btn-login">Se connecter</a>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero-section">
        <div class="hero-logo" style="margin-bottom: 20px;">
            <img src="/images/novec-logo.svg" alt="NOVEC Logo" style="height: 120px; width: auto; margin-bottom: 20px;">
        </div>
        <h1 class="hero-title">Plateforme de Gestion des Plans d'Action</h1>
        <p class="hero-subtitle">Piloter, suivre et clôturer efficacement les actions de votre organisation</p>
        <div class="hero-buttons">
            <a href="@Url.Action("Login", "Account")" class="btn-primary">Se connecter</a>
        </div>
    </section>

    <!-- Presentation -->
    <section class="presentation-section">
        <h2 class="section-title">À propos de la plateforme</h2>
        <p class="presentation-text">
            La plateforme de Gestion des Plans d'Action (GPA) de NOVEC Group est une solution professionnelle
            et sécurisée conçue pour centraliser, suivre et contrôler efficacement l'exécution de vos plans d'action.
        </p>
        <p class="presentation-text">
            Avec quatre rôles distincts (Administrateur, Directeur, Gestionnaire, Responsable), chacun avec ses
            permissions spécifiques, la plateforme assure une traçabilité complète et une gouvernance rigoureuse de
            tous les plans d'action, de leur création à leur clôture.
        </p>
    </section>

    <!-- Features Section -->
    <section class="features-section">
        <div class="features-container">
            <h2 class="section-title">Fonctionnalités principales</h2>
            <div class="features-grid">
                <div class="feature-card">
                    <div class="feature-icon">📋</div>
                    <h3 class="feature-title">Gestion des plans d'action</h3>
                    <p class="feature-description">Créez, organisez et gérez vos plans d'action de manière structurée avec suivi du statut et de la progression.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">✓</div>
                    <h3 class="feature-title">Suivi des actions</h3>
                    <p class="feature-description">Suivez en temps réel l'exécution de chaque action assignée avec détails complets et historique.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">👥</div>
                    <h3 class="feature-title">Gestion des responsables</h3>
                    <p class="feature-description">Assignez les actions aux responsables appropriés avec permissions basées sur les rôles.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">📎</div>
                    <h3 class="feature-title">Suivi des preuves</h3>
                    <p class="feature-description">Collectez les preuves de réalisation avec pièces jointes sécurisées et validation gestionnaire.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">📝</div>
                    <h3 class="feature-title">Journalisation</h3>
                    <p class="feature-description">Bénéficiez d'une traçabilité complète avec journal d'audit détaillé de toutes les actions.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">📊</div>
                    <h3 class="feature-title">Dashboard</h3>
                    <p class="feature-description">Visualisez les indicateurs clés (KPI) et statistiques de vos plans d'action en un coup d'œil.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">📄</div>
                    <h3 class="feature-title">Export des rapports</h3>
                    <p class="feature-description">Générez et exportez des rapports détaillés en Excel ou PDF pour analyse et partage.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Workflow Section -->
    <section class="workflow-section">
        <div class="workflow-container">
            <h2 class="section-title">Processus de gestion</h2>
            <div class="workflow-grid">
                <div class="workflow-step">
                    <div class="workflow-number">1</div>
                    <div class="workflow-icon">✏️</div>
                    <h3 class="workflow-title">Créer</h3>
                    <p class="workflow-description">Définir le plan d'action et ses actions détaillées</p>
                </div>
                <div class="workflow-step">
                    <div class="workflow-number">2</div>
                    <div class="workflow-icon">📤</div>
                    <h3 class="workflow-title">Transmettre</h3>
                    <p class="workflow-description">Transmettre le plan aux responsables pour exécution</p>
                </div>
                <div class="workflow-step">
                    <div class="workflow-number">3</div>
                    <div class="workflow-icon">✓</div>
                    <h3 class="workflow-title">Accepter</h3>
                    <p class="workflow-description">Accepter ou rejeter les actions assignées</p>
                </div>
                <div class="workflow-step">
                    <div class="workflow-number">4</div>
                    <div class="workflow-icon">🔄</div>
                    <h3 class="workflow-title">Suivre</h3>
                    <p class="workflow-description">Exécuter et mettre à jour la progression des actions</p>
                </div>
                <div class="workflow-step">
                    <div class="workflow-number">5</div>
                    <div class="workflow-icon">📎</div>
                    <h3 class="workflow-title">Prouver</h3>
                    <p class="workflow-description">Soumettre les preuves et pièces jointes</p>
                </div>
                <div class="workflow-step">
                    <div class="workflow-number">6</div>
                    <div class="workflow-icon">✅</div>
                    <h3 class="workflow-title">Clôturer</h3>
                    <p class="workflow-description">Valider les preuves et clôturer les actions</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="public-footer">
        <div class="footer-content">
            <p class="footer-text">&copy; 2026 NOVEC Group. Tous droits réservés.</p>
            <div class="footer-links">
                <a href="#" class="footer-link">Politique de confidentialité</a>
                <a href="#" class="footer-link">Conditions d'utilisation</a>
                <a href="#" class="footer-link">Support</a>
                <a href="#" class="footer-link">Contact</a>
            </div>
        </div>
    </footer>
</body>
</html>
