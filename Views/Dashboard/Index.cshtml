@model DashboardViewModel

@{
    ViewData["Title"] = "Tableau de bord";
}

<style>
    .dashboard-container {
        display: flex;
        flex-direction: column;
        gap: 30px;
    }

    .dashboard-header {
        margin-bottom: 30px;
    }

    .dashboard-title {
        font-size: 2rem;
        font-weight: 700;
        color: var(--text-primary);
        margin: 0;
    }

    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .kpi-card {
        background: white;
        border-radius: 8px;
        padding: 25px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        transition: all 0.3s ease;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        border-left: 4px solid;
    }

    .kpi-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);
    }

    .kpi-card.primary {
        border-left-color: var(--primary-color);
    }

    .kpi-card.success {
        border-left-color: var(--success-color);
    }

    .kpi-card.warning {
        border-left-color: var(--warning-color);
    }

    .kpi-card.danger {
        border-left-color: var(--danger-color);
    }

    .kpi-content {
        flex: 1;
    }

    .kpi-label {
        font-size: 0.85rem;
        color: var(--text-secondary);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 8px;
    }

    .kpi-value {
        font-size: 2.5rem;
        font-weight: 700;
        color: var(--text-primary);
        margin: 0;
    }

    .kpi-icon {
        font-size: 2.5rem;
        opacity: 0.15;
        margin-left: 15px;
    }

    .kpi-card.primary .kpi-icon {
        color: var(--primary-color);
    }

    .kpi-card.success .kpi-icon {
        color: var(--success-color);
    }

    .kpi-card.warning .kpi-icon {
        color: var(--warning-color);
    }

    .kpi-card.danger .kpi-icon {
        color: var(--danger-color);
    }

    .charts-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .chart-card {
        background: white;
        border-radius: 8px;
        padding: 25px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }

    .chart-title {
        font-size: 1.2rem;
        font-weight: 600;
        color: var(--text-primary);
        margin: 0 0 20px 0;
        padding-bottom: 15px;
        border-bottom: 2px solid var(--border-color);
    }

    .progress-item {
        margin-bottom: 20px;
    }

    .progress-label {
        display: flex;
        justify-content: space-between;
        margin-bottom: 8px;
        font-size: 0.9rem;
    }

    .progress-label-text {
        font-weight: 600;
        color: var(--text-primary);
    }

    .progress-label-value {
        color: var(--text-secondary);
    }

    .progress-bar {
        width: 100%;
        height: 8px;
        background-color: #e0e0e0;
        border-radius: 4px;
        overflow: hidden;
    }

    .progress-fill {
        height: 100%;
        background: linear-gradient(90deg, var(--primary-color), var(--primary-light));
        transition: width 0.3s ease;
    }

    .status-distribution {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 15px;
    }

    .status-item {
        text-align: center;
        padding: 15px;
        background: var(--light-bg);
        border-radius: 6px;
    }

    .status-icon {
        font-size: 2rem;
        margin-bottom: 8px;
    }

    .status-count {
        font-size: 1.8rem;
        font-weight: 700;
        color: var(--text-primary);
        margin: 5px 0;
    }

    .status-name {
        font-size: 0.85rem;
        color: var(--text-secondary);
        font-weight: 600;
    }

    .metrics-table {
        width: 100%;
        border-collapse: collapse;
    }

    .metrics-table th {
        background-color: var(--light-bg);
        padding: 12px 15px;
        text-align: left;
        font-weight: 600;
        color: var(--text-primary);
        border-bottom: 2px solid var(--border-color);
        font-size: 0.9rem;
    }

    .metrics-table td {
        padding: 12px 15px;
        border-bottom: 1px solid var(--border-color);
        color: var(--text-primary);
    }

    .metrics-table tbody tr:hover {
        background-color: var(--light-bg);
    }

    .completion-rate {
        font-size: 2.2rem;
        font-weight: 700;
        color: var(--success-color);
        text-align: center;
        padding: 20px;
    }

    .completion-label {
        text-align: center;
        color: var(--text-secondary);
        font-weight: 600;
    }

    @media (max-width: 768px) {
        .kpi-grid {
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        }

        .charts-row {
            grid-template-columns: 1fr;
        }

        .dashboard-title {
            font-size: 1.5rem;
        }

        .kpi-value {
            font-size: 2rem;
        }

        .completion-rate {
            font-size: 1.8rem;
        }
    }
</style>

<div class="dashboard-container">
    <div class="dashboard-header">
        <h1 class="dashboard-title">📊 Tableau de bord</h1>
    </div>

    <!-- KPI Cards -->
    <div class="kpi-grid">
        <div class="kpi-card primary">
            <div class="kpi-content">
                <div class="kpi-label">Total Actions</div>
                <p class="kpi-value">@Model.Metrics.TotalActions</p>
            </div>
            <div class="kpi-icon">✓</div>
        </div>

        <div class="kpi-card success">
            <div class="kpi-content">
                <div class="kpi-label">Complétées</div>
                <p class="kpi-value">@Model.Metrics.CompletedActions</p>
            </div>
            <div class="kpi-icon">✓✓</div>
        </div>

        <div class="kpi-card warning">
            <div class="kpi-content">
                <div class="kpi-label">En cours</div>
                <p class="kpi-value">@Model.Metrics.InProgressActions</p>
            </div>
            <div class="kpi-icon">🔄</div>
        </div>

        <div class="kpi-card danger">
            <div class="kpi-content">
                <div class="kpi-label">En retard</div>
                <p class="kpi-value">@Model.Metrics.OverdueActions</p>
            </div>
            <div class="kpi-icon">⚠️</div>
        </div>
    </div>

    <!-- Charts Row -->
    <div class="charts-row">
        <!-- Completion Status -->
        <div class="chart-card">
            <h3 class="chart-title">📈 Statut des Actions</h3>
            <div class="status-distribution">
                <div class="status-item">
                    <div class="status-icon">🔵</div>
                    <div class="status-count">@Model.Metrics.NewActions</div>
                    <div class="status-name">Nouvelles</div>
                </div>
                <div class="status-item">
                    <div class="status-icon">✓</div>
                    <div class="status-count">@Model.Metrics.AcceptedActions</div>
                    <div class="status-name">Acceptées</div>
                </div>
                <div class="status-item">
                    <div class="status-icon">🔄</div>
                    <div class="status-count">@Model.Metrics.InProgressActions</div>
                    <div class="status-name">En cours</div>
                </div>
                <div class="status-item">
                    <div class="status-icon">✕</div>
                    <div class="status-count">@Model.Metrics.RejectedActions</div>
                    <div class="status-name">Rejetées</div>
                </div>
                <div class="status-item">
                    <div class="status-icon">📎</div>
                    <div class="status-count">@Model.Metrics.SubmittedEvidenceActions</div>
                    <div class="status-name">Preuves</div>
                </div>
                <div class="status-item">
                    <div class="status-icon">✓✓</div>
                    <div class="status-count">@Model.Metrics.CompletedActions</div>
                    <div class="status-name">Complétées</div>
                </div>
            </div>
        </div>

        <!-- Completion Rate -->
        <div class="chart-card">
            <h3 class="chart-title">⚡ Taux de Clôture</h3>
            <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 200px;">
                <div class="completion-rate">@Math.Round(Model.Metrics.CompletionRate, 1)%</div>
                <div class="completion-label">des actions sont clôturées</div>
                <div style="width: 100%; height: 8px; background-color: #e0e0e0; border-radius: 4px; margin-top: 15px; overflow: hidden;">
                    <div style="height: 100%; background: linear-gradient(90deg, var(--success-color), var(--primary-color)); width: @(Model.Metrics.CompletionRate)%; transition: width 0.3s ease;"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Progress by Status -->
    <div class="chart-card">
        <h3 class="chart-title">📊 Avancement par Statut</h3>
        <div class="progress-item">
            <div class="progress-label">
                <span class="progress-label-text">Brouillon</span>
                <span class="progress-label-value">@Model.Metrics.DraftActions</span>
            </div>
            <div class="progress-bar">
                <div class="progress-fill" style="width: @(Model.Metrics.TotalActions > 0 ? (Model.Metrics.DraftActions * 100 / Model.Metrics.TotalActions) : 0)%"></div>
            </div>
        </div>

        <div class="progress-item">
            <div class="progress-label">
                <span class="progress-label-text">Acceptées</span>
                <span class="progress-label-value">@Model.Metrics.AcceptedActions</span>
            </div>
            <div class="progress-bar">
                <div class="progress-fill" style="width: @(Model.Metrics.TotalActions > 0 ? (Model.Metrics.AcceptedActions * 100 / Model.Metrics.TotalActions) : 0)%"></div>
            </div>
        </div>

        <div class="progress-item">
            <div class="progress-label">
                <span class="progress-label-text">En cours</span>
                <span class="progress-label-value">@Model.Metrics.InProgressActions</span>
            </div>
            <div class="progress-bar">
                <div class="progress-fill" style="width: @(Model.Metrics.TotalActions > 0 ? (Model.Metrics.InProgressActions * 100 / Model.Metrics.TotalActions) : 0)%"></div>
            </div>
        </div>

        <div class="progress-item">
            <div class="progress-label">
                <span class="progress-label-text">Clôturées</span>
                <span class="progress-label-value">@Model.Metrics.CompletedActions</span>
            </div>
            <div class="progress-bar">
                <div class="progress-fill" style="width: @(Model.Metrics.TotalActions > 0 ? (Model.Metrics.CompletedActions * 100 / Model.Metrics.TotalActions) : 0)%; background: linear-gradient(90deg, var(--success-color), #16a085);"></div>
            </div>
        </div>
    </div>

    <!-- Plans Summary -->
    <div class="chart-card">
        <h3 class="chart-title">📋 Résumé des Plans d'Action</h3>
        <table class="metrics-table">
            <thead>
                <tr>
                    <th>Métrique</th>
                    <th style="text-align: right;">Valeur</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Total Plans d'Action</td>
                    <td style="text-align: right;"><strong>@Model.Metrics.TotalActionPlans</strong></td>
                </tr>
                <tr>
                    <td>Actions Soumises en Preuve</td>
                    <td style="text-align: right;"><strong>@Model.Metrics.SubmittedEvidenceActions</strong></td>
                </tr>
                <tr>
                    <td>Actions en Retard</td>
                    <td style="text-align: right; color: var(--danger-color);"><strong>@Model.Metrics.OverdueActions</strong></td>
                </tr>
                <tr>
                    <td>Taux de Clôture Moyen</td>
                    <td style="text-align: right; color: var(--success-color);"><strong>@Math.Round(Model.Metrics.CompletionRate, 1)%</strong></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
