@model ActionDetailViewModel

@{
    ViewData["Title"] = $"Action: {Model.Action.Title}";
}

<style>
    .action-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 30px;
        gap: 20px;
    }

    .action-title-section h1 {
        font-size: 2rem;
        font-weight: 700;
        color: var(--text-primary);
        margin: 0 0 8px 0;
    }

    .action-reference {
        color: var(--text-secondary);
        font-size: 0.95rem;
    }

    .status-badge-detail {
        display: inline-block;
        padding: 8px 16px;
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.9rem;
    }

    .details-layout {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 20px;
        margin-bottom: 30px;
    }

    .details-card {
        background: white;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        overflow: hidden;
    }

    .details-card-header {
        background: var(--light-bg);
        border-bottom: 2px solid var(--border-color);
        padding: 16px 20px;
        font-weight: 600;
        color: var(--text-primary);
        font-size: 1.05rem;
    }

    .details-card-body {
        padding: 20px;
    }

    .info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-top: 15px;
    }

    .info-item {
        padding: 12px;
        background: var(--light-bg);
        border-radius: 6px;
    }

    .info-label {
        font-size: 0.85rem;
        color: var(--text-secondary);
        font-weight: 600;
        margin-bottom: 4px;
    }

    .info-value {
        color: var(--text-primary);
        font-size: 0.95rem;
    }

    .priority-display {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 16px;
        font-size: 0.85rem;
        font-weight: 600;
    }

    .priority-low {
        background: #e0e0e0;
        color: #555;
    }

    .priority-medium {
        background: #fff3e0;
        color: #e65100;
    }

    .priority-high {
        background: #ffebee;
        color: var(--danger-color);
    }

    .priority-critical {
        background: #c62828;
        color: white;
    }

    .progress-container {
        margin-top: 15px;
    }

    .progress-label {
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--text-primary);
        margin-bottom: 8px;
    }

    .progress-bar-wrapper {
        width: 100%;
        height: 8px;
        background: #e0e0e0;
        border-radius: 4px;
        overflow: hidden;
    }

    .progress-fill {
        height: 100%;
        background: linear-gradient(90deg, var(--primary-color), var(--secondary-color));
        transition: width 0.3s ease;
    }

    .progress-text {
        display: inline-block;
        margin-top: 8px;
        font-weight: 600;
        color: var(--primary-color);
        font-size: 0.9rem;
    }

    .action-buttons {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .action-button {
        padding: 12px 16px;
        border: none;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
        text-align: center;
        transition: all 0.3s ease;
        font-size: 0.95rem;
        text-decoration: none;
        display: block;
    }

    .btn-accept {
        background: var(--success-color);
        color: white;
    }

    .btn-accept:hover {
        background: #229954;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(39, 174, 96, 0.3);
    }

    .btn-reject {
        background: var(--danger-color);
        color: white;
    }

    .btn-reject:hover {
        background: #c0392b;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(231, 76, 60, 0.3);
    }

    .btn-evidence {
        background: var(--primary-color);
        color: white;
    }

    .btn-evidence:hover {
        background: #1e3e7d;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(42, 82, 152, 0.3);
    }

    .rejection-reason {
        background: #ffebee;
        border-left: 4px solid var(--danger-color);
        padding: 12px;
        border-radius: 4px;
        margin-top: 15px;
        color: #c62828;
        font-size: 0.9rem;
    }

    .key-dates {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        margin-top: 10px;
    }

    .date-item {
        padding: 10px;
        background: var(--light-bg);
        border-radius: 6px;
    }

    .date-label {
        font-size: 0.8rem;
        color: var(--text-secondary);
        font-weight: 600;
    }

    .date-value {
        color: var(--text-primary);
        font-size: 0.9rem;
        margin-top: 4px;
    }

    /* Evidence Section */
    .evidences-section {
        margin-top: 30px;
    }

    .evidence-card {
        background: white;
        border-radius: 8px;
        border-left: 4px solid;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        margin-bottom: 15px;
        overflow: hidden;
    }

    .evidence-card-header {
        padding: 16px 20px;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        background: var(--light-bg);
        border-bottom: 1px solid var(--border-color);
    }

    .evidence-info {
        font-size: 0.9rem;
        line-height: 1.6;
    }

    .evidence-status-badge {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 12px;
        font-size: 0.85rem;
        font-weight: 600;
        white-space: nowrap;
    }

    .evidence-submitted {
        background: #e3f2fd;
        color: #1565c0;
        border-left-color: #1565c0;
    }

    .evidence-approved {
        background: #e8f5e9;
        color: #1b5e20;
        border-left-color: #27ae60;
    }

    .evidence-rejected {
        background: #ffebee;
        color: #c62828;
        border-left-color: var(--danger-color);
    }

    .evidence-card-body {
        padding: 16px 20px;
    }

    .evidence-comment {
        color: var(--text-primary);
        margin-bottom: 12px;
        line-height: 1.6;
    }

    .attachments-list {
        margin-top: 12px;
    }

    .attachment-label {
        font-weight: 600;
        color: var(--text-primary);
        font-size: 0.9rem;
        margin-bottom: 8px;
    }

    .attachment-item {
        display: flex;
        align-items: center;
        padding: 8px;
        background: var(--light-bg);
        border-radius: 4px;
        margin-bottom: 6px;
        text-decoration: none;
        color: var(--primary-color);
        transition: all 0.3s ease;
    }

    .attachment-item:hover {
        background: #e8f4f8;
    }

    .attachment-icon {
        margin-right: 8px;
    }

    .attachment-name {
        flex: 1;
        font-weight: 600;
        font-size: 0.9rem;
    }

    .attachment-size {
        font-size: 0.8rem;
        color: var(--text-secondary);
    }

    /* Evidence Submission Form */
    .evidence-form {
        background: white;
        border-radius: 8px;
        padding: 20px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        margin-top: 15px;
    }

    .evidence-form-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--text-primary);
        margin-bottom: 16px;
        border-bottom: 2px solid var(--border-color);
        padding-bottom: 12px;
    }

    .form-group {
        margin-bottom: 16px;
    }

    .form-label {
        display: block;
        font-weight: 600;
        color: var(--text-primary);
        margin-bottom: 6px;
        font-size: 0.9rem;
    }

    .form-control {
        width: 100%;
        padding: 10px 12px;
        border: 1px solid var(--border-color);
        border-radius: 6px;
        font-family: inherit;
        font-size: 0.95rem;
        transition: all 0.3s ease;
        box-sizing: border-box;
    }

    .form-control:focus {
        outline: none;
        border-color: var(--primary-color);
        box-shadow: 0 0 0 3px rgba(42, 82, 152, 0.1);
    }

    .form-control:disabled {
        background: var(--light-bg);
        cursor: not-allowed;
        opacity: 0.6;
    }

    textarea.form-control {
        resize: vertical;
        min-height: 100px;
    }

    .file-upload-wrapper {
        position: relative;
        display: inline-block;
        width: 100%;
    }

    .file-upload-label {
        display: block;
        padding: 24px;
        border: 2px dashed var(--border-color);
        border-radius: 6px;
        text-align: center;
        cursor: pointer;
        transition: all 0.3s ease;
        background: var(--light-bg);
    }

    .file-upload-label:hover {
        border-color: var(--primary-color);
        background: #f0f7ff;
    }

    .file-upload-input {
        display: none;
    }

    .file-upload-text {
        font-size: 0.9rem;
        color: var(--text-secondary);
    }

    .file-upload-icon {
        font-size: 1.5rem;
        display: block;
        margin-bottom: 8px;
    }

    .submit-button {
        background: var(--primary-color);
        color: white;
        padding: 12px 20px;
        border: none;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        font-size: 0.95rem;
    }

    .submit-button:hover {
        background: #1e3e7d;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(42, 82, 152, 0.3);
    }

    /* Timeline */
    .timeline {
        position: relative;
        padding: 20px 0;
    }

    .timeline-item {
        position: relative;
        padding-left: 40px;
        margin-bottom: 24px;
    }

    .timeline-item::before {
        content: '';
        position: absolute;
        left: 0;
        top: 2px;
        width: 12px;
        height: 12px;
        background: var(--primary-color);
        border-radius: 50%;
        border: 3px solid white;
        box-shadow: 0 0 0 2px var(--border-color);
    }

    .timeline-item.completed::before {
        background: var(--success-color);
    }

    .timeline-item.rejected::before {
        background: var(--danger-color);
    }

    .timeline-event-title {
        font-weight: 600;
        color: var(--text-primary);
        font-size: 0.95rem;
    }

    .timeline-event-meta {
        font-size: 0.85rem;
        color: var(--text-secondary);
        margin-top: 4px;
    }

    .timeline-event-comment {
        margin-top: 8px;
        color: var(--text-primary);
        font-size: 0.9rem;
    }

    .back-button {
        display: inline-block;
        padding: 10px 16px;
        background: var(--light-bg);
        color: var(--primary-color);
        text-decoration: none;
        border-radius: 6px;
        font-weight: 600;
        transition: all 0.3s ease;
        margin-top: 20px;
    }

    .back-button:hover {
        background: #e8f4f8;
    }

    .reject-form-group {
        margin-bottom: 12px;
    }

    @media (max-width: 1024px) {
        .details-layout {
            grid-template-columns: 1fr;
        }

        .info-grid {
            grid-template-columns: 1fr;
        }

        .action-header {
            flex-direction: column;
        }
    }

    @media (max-width: 768px) {
        .action-header {
            flex-direction: column;
        }

        .details-layout {
            grid-template-columns: 1fr;
        }

        .info-grid {
            grid-template-columns: 1fr;
        }

        .action-title-section h1 {
            font-size: 1.5rem;
        }

        .key-dates {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="action-header">
    <div class="action-title-section">
        <h1>@Model.Action.Title</h1>
        <p class="action-reference">Référence: <strong>@Model.Action.Reference</strong></p>
    </div>
    <span class="status-badge-detail @GetStatusClass(Model.Action.Status)">
        @GetStatusDisplay(Model.Action.Status)
    </span>
</div>

<!-- Main Layout -->
<div class="details-layout">
    <!-- Left Column: Details -->
    <div>
        <!-- Information Card -->
        <div class="details-card">
            <div class="details-card-header">ℹ️ Informations</div>
            <div class="details-card-body">
                <p style="color: var(--text-primary); line-height: 1.6;">@Model.Action.Description</p>

                <div class="info-grid">
                    <div class="info-item">
                        <div class="info-label">Responsable</div>
                        <div class="info-value">@Model.Action.ResponsibleName</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Gestionnaire</div>
                        <div class="info-value">@Model.Action.ManagerName</div>
                    </div>
                </div>

                <div class="info-grid">
                    <div class="info-item">
                        <div class="info-label">Priorité</div>
                        <span class="priority-display @GetPriorityCssClass(Model.Action.Priority)">
                            @GetPriorityDisplay(Model.Action.Priority)
                        </span>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Plan d'action</div>
                        <div class="info-value">@Model.Action.ActionPlanTitle</div>
                    </div>
                </div>

                <div class="info-grid">
                    <div class="info-item">
                        <div class="info-label">Début</div>
                        <div class="info-value">@Model.Action.StartDate.ToShortDateString()</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Échéance</div>
                        <div class="info-value">
                            @if (Model.Action.IsOverdue)
                            {
                                <span style="color: var(--danger-color); font-weight: 600;">⚠️ @Model.Action.DueDate.ToShortDateString()</span>
                            }
                            else
                            {
                                @Model.Action.DueDate.ToShortDateString()
                            }
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.RejectionReason))
                {
                    <div class="rejection-reason">
                        <strong>Motif du rejet:</strong><br/>
                        @Model.RejectionReason
                    </div>
                }
            </div>
        </div>

        <!-- Progress Card -->
        <div class="details-card" style="margin-top: 20px;">
            <div class="details-card-header">📊 Avancement</div>
            <div class="details-card-body">
                <div class="progress-container">
                    <div class="progress-label">Progression globale</div>
                    <div class="progress-bar-wrapper">
                        <div class="progress-fill" style="width: @(Model.Action.ProgressPercentage)%"></div>
                    </div>
                    <div class="progress-text">@Model.Action.ProgressPercentage%</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column: Actions & Dates -->
    <div>
        <!-- Actions Card -->
        <div class="details-card">
            <div class="details-card-header">⚡ Actions</div>
            <div class="details-card-body">
                <div class="action-buttons">
                    @if (Model.Action.Status == ActionStatus.New)
                    {
                        <form asp-action="Accept" asp-route-id="@Model.Action.Id" method="post">
                            <button type="submit" class="action-button btn-accept">✓ Accepter</button>
                        </form>
                        <form asp-action="Reject" asp-route-id="@Model.Action.Id" method="post">
                            <div class="reject-form-group">
                                <input type="text" name="reason" class="form-control" placeholder="Motif du rejet..." required />
                            </div>
                            <button type="submit" class="action-button btn-reject" onclick="return confirm('Êtes-vous sûr de rejeter cette action?')">
                                ✕ Rejeter
                            </button>
                        </form>
                    }
                    else if (Model.Action.Status == ActionStatus.Accepted || Model.Action.Status == ActionStatus.InProgress)
                    {
                        <a href="#evidence-form" class="action-button btn-evidence">📎 Soumettre une preuve</a>
                    }
                    else if (Model.Action.Status == ActionStatus.EvidenceSubmitted)
                    {
                        @if (User.IsInRole("ADMIN") || User.IsInRole("GESTIONNAIRE"))
                        {
                            <form asp-action="Complete" asp-route-id="@Model.Action.Id" method="post">
                                <button type="submit" class="action-button btn-accept" onclick="return confirm('Êtes-vous sûr de clôturer cette action?')">✓ Clôturer</button>
                            </form>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- Key Dates Card -->
        <div class="details-card" style="margin-top: 20px;">
            <div class="details-card-header">📅 Dates clés</div>
            <div class="details-card-body">
                <div class="key-dates">
                    <div class="date-item">
                        <div class="date-label">Créée le</div>
                        <div class="date-value">@Model.Action.CreatedAt.ToString("g")</div>
                    </div>
                    @if (Model.Action.CompletedAt.HasValue)
                    {
                        <div class="date-item">
                            <div class="date-label">Clôturée le</div>
                            <div class="date-value">@Model.Action.CompletedAt.Value.ToString("g")</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Evidences Section -->
<div class="evidences-section">
    <div class="details-card">
        <div class="details-card-header">📎 Preuves (@Model.Evidences.Count())</div>
        <div class="details-card-body">
            @if (Model.Evidences.Any())
            {
                @foreach (var evidence in Model.Evidences.OrderByDescending(e => e.SubmittedAt))
                {
                    <div class="evidence-card @GetEvidenceCardClass(evidence.Status)">
                        <div class="evidence-card-header">
                            <div class="evidence-info">
                                <strong>Soumise le:</strong> @evidence.SubmittedAt.ToString("g")<br/>
                                <strong>Par:</strong> @evidence.SubmittedByName
                            </div>
                            <span class="evidence-status-badge">
                                @GetEvidenceStatusDisplay(evidence.Status)
                            </span>
                        </div>
                        <div class="evidence-card-body">
                            <div class="evidence-comment">@evidence.Comment</div>

                            @if (evidence.Attachments.Any())
                            {
                                <div class="attachments-list">
                                    <div class="attachment-label">📁 Pièces jointes</div>
                                    @foreach (var attachment in evidence.Attachments)
                                    {
                                        <a href="@attachment.FilePath" download class="attachment-item">
                                            <span class="attachment-icon">📥</span>
                                            <span class="attachment-name">@attachment.FileName</span>
                                            <span class="attachment-size">@attachment.FileSizeDisplay</span>
                                        </a>
                                    }
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(evidence.RejectionReason))
                            {
                                <div class="rejection-reason" style="margin-top: 12px;">
                                    <strong>Motif du rejet:</strong><br/>
                                    @evidence.RejectionReason
                                </div>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <p style="color: var(--text-secondary); font-style: italic; margin: 0;">Aucune preuve soumise pour le moment.</p>
            }
        </div>
    </div>
</div>

<!-- Evidence Submission Form -->
@if (Model.Action.Status == ActionStatus.Accepted || Model.Action.Status == ActionStatus.InProgress || Model.Action.Status == ActionStatus.EvidenceRejected)
{
    <div class="evidence-form" id="evidence-form">
        <div class="evidence-form-title">📤 Soumettre une preuve</div>
        <form asp-action="SubmitEvidence" asp-route-id="@Model.Action.Id" method="post" enctype="multipart/form-data">
            <div class="form-group">
                <label class="form-label" for="comment">Commentaire</label>
                <textarea class="form-control" id="comment" name="comment" placeholder="Décrivez votre preuve..." required></textarea>
            </div>

            <div class="form-group">
                <label class="form-label">Pièces jointes</label>
                <div class="file-upload-wrapper">
                    <label for="attachments" class="file-upload-label">
                        <span class="file-upload-icon">📎</span>
                        <span class="file-upload-text">Cliquez pour ajouter des fichiers ou déposez-les ici</span>
                        <input type="file" id="attachments" name="attachments" class="file-upload-input" multiple/>
                    </label>
                </div>
            </div>

            <button type="submit" class="submit-button">✓ Soumettre la preuve</button>
        </form>
    </div>
}

<!-- Journal d'audit -->
<div class="evidences-section" style="margin-top: 30px;">
    <div class="details-card">
        <div class="details-card-header">📜 Journal d'action (@Model.Logs.Count())</div>
        <div class="details-card-body">
            <div class="timeline">
                @foreach (var log in Model.Logs.OrderByDescending(l => l.CreatedAt))
                {
                    <div class="timeline-item @GetTimelineClass(log.EventType)">
                        <div class="timeline-event-title">@log.EventTypeDisplay</div>
                        <div class="timeline-event-meta">@log.CreatedAt.ToString("g") par @log.CreatedByName</div>
                        @if (!string.IsNullOrEmpty(log.Comment))
                        {
                            <div class="timeline-event-comment">@log.Comment</div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<a asp-action="Index" class="back-button">← Retour à la liste</a>

@functions {
    string GetStatusClass(ActionStatus status)
    {
        return status switch
        {
            ActionStatus.Draft => "status-draft",
            ActionStatus.New => "status-new",
            ActionStatus.Accepted => "status-accepted",
            ActionStatus.Rejected => "status-rejected",
            ActionStatus.InProgress => "status-in-progress",
            ActionStatus.EvidenceSubmitted => "status-evidence",
            ActionStatus.EvidenceRejected => "status-evidence-rejected",
            ActionStatus.Completed => "status-completed",
            _ => "status-default"
        };
    }

    string GetStatusDisplay(ActionStatus status)
    {
        return status switch
        {
            ActionStatus.Draft => "🔨 Brouillon",
            ActionStatus.New => "🔵 Nouvelle",
            ActionStatus.Accepted => "✓ Acceptée",
            ActionStatus.Rejected => "✕ Rejetée",
            ActionStatus.InProgress => "🔄 En cours",
            ActionStatus.EvidenceSubmitted => "📎 Preuve soumise",
            ActionStatus.EvidenceRejected => "⚠️ Preuve rejetée",
            ActionStatus.Completed => "✓✓ Complétée",
            _ => "? Inconnue"
        };
    }

    string GetPriorityCssClass(ActionPriority priority)
    {
        return priority switch
        {
            ActionPriority.Low => "priority-low",
            ActionPriority.Medium => "priority-medium",
            ActionPriority.High => "priority-high",
            ActionPriority.Critical => "priority-critical",
            _ => "priority-low"
        };
    }

    string GetPriorityDisplay(ActionPriority priority)
    {
        return priority switch
        {
            ActionPriority.Low => "Basse",
            ActionPriority.Medium => "Moyenne",
            ActionPriority.High => "Haute",
            ActionPriority.Critical => "Critique",
            _ => "Inconnue"
        };
    }

    string GetEvidenceCardClass(EvidenceStatus status)
    {
        return status switch
        {
            EvidenceStatus.Submitted => "evidence-submitted",
            EvidenceStatus.Approved => "evidence-approved",
            EvidenceStatus.Rejected => "evidence-rejected",
            _ => "evidence-submitted"
        };
    }

    string GetEvidenceStatusDisplay(EvidenceStatus status)
    {
        return status switch
        {
            EvidenceStatus.Submitted => "📎 Soumise",
            EvidenceStatus.Approved => "✓ Approuvée",
            EvidenceStatus.Rejected => "✕ Rejetée",
            _ => "? Inconnue"
        };
    }

    string GetTimelineClass(ActionLogEventType eventType)
    {
        return eventType switch
        {
            ActionLogEventType.Completed => "completed",
            ActionLogEventType.Rejected => "rejected",
            _ => ""
        };
    }
}

