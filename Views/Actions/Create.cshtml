@model CreateActionViewModel
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = "Créer une action";
    var responsibles = (IEnumerable<ApplicationUser>)ViewData["Responsibles"];
}

<div class="container">
    <h1 class="mb-4">
        <i class="fas fa-plus-circle"></i> Créer une nouvelle action
    </h1>

    <form asp-action="Create" method="post" class="row">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Reference" class="form-label">Référence *</label>
                        <input asp-for="Reference" class="form-control" placeholder="ACT-2026-001" required />
                        <span asp-validation-for="Reference" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label">Intitulé *</label>
                        <input asp-for="Title" class="form-control" placeholder="Titre de l'action" required />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="4"
                                  placeholder="Détails et contexte de l'action..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Priority" class="form-label">Priorité *</label>
                                <select asp-for="Priority" class="form-select" required>
                                    <option value="">-- Sélectionner --</option>
                                    <option value="0">Basse</option>
                                    <option value="1" selected>Moyenne</option>
                                    <option value="2">Haute</option>
                                    <option value="3">Critique</option>
                                </select>
                                <span asp-validation-for="Priority" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="ResponsibleId" class="form-label">Responsable *</label>
                                <select asp-for="ResponsibleId" class="form-select" required>
                                    <option value="">-- Sélectionner --</option>
                                    @foreach (var user in responsibles)
                                    {
                                        <option value="@user.Id">@user.FullName</option>
                                    }
                                </select>
                                <span asp-validation-for="ResponsibleId" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="StartDate" class="form-label">Date de début *</label>
                                <input asp-for="StartDate" class="form-control" type="date" required />
                                <span asp-validation-for="StartDate" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="DueDate" class="form-label">Date d'échéance *</label>
                                <input asp-for="DueDate" class="form-control" type="date" required />
                                <span asp-validation-for="DueDate" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <input type="hidden" asp-for="ActionPlanId" />

                    <div class="alert alert-info">
                        <i class="fas fa-info-circle"></i>
                        <strong>Info :</strong> L'action sera créée en <strong>Brouillon</strong>
                        et devra être transmise au responsable.
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save"></i> Créer l'action
                        </button>
                        <a asp-action="Index" asp-route-planId="@Model.ActionPlanId" class="btn btn-secondary">
                            <i class="fas fa-times"></i> Annuler
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card bg-light">
                <div class="card-header">
                    <h5 class="mb-0">Workflow</h5>
                </div>
                <div class="card-body small">
                    <div class="timeline">
                        <div class="timeline-item">
                            <strong>Brouillon</strong><br/>
                            <small>Création</small>
                        </div>
                        <div class="timeline-item">
                            <strong>Nouveau</strong><br/>
                            <small>Transmission</small>
                        </div>
                        <div class="timeline-item">
                            <strong>Acceptée</strong><br/>
                            <small>Responsable accepte</small>
                        </div>
                        <div class="timeline-item">
                            <strong>Complétée</strong><br/>
                            <small>Preuve validée</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

<style>
    .timeline-item {
        padding-left: 20px;
        margin-bottom: 15px;
        position: relative;
    }

    .timeline-item::before {
        content: '';
        position: absolute;
        left: 0;
        top: 3px;
        width: 8px;
        height: 8px;
        background-color: #2a5298;
        border-radius: 50%;
    }
</style>
