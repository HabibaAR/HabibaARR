@model CreateActionViewModel
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = "Créer une action";
    var responsibles = (IEnumerable<ApplicationUser>)ViewData["Responsibles"];
}

<style>
    .create-page-title {
        font-size: 2rem;
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 30px;
    }

    .create-layout {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 20px;
        margin-bottom: 20px;
    }

    .form-card {
        background: white;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        padding: 24px;
    }

    .form-group {
        margin-bottom: 18px;
    }

    .form-label {
        display: block;
        font-weight: 600;
        color: var(--text-primary);
        margin-bottom: 6px;
        font-size: 0.9rem;
    }

    .form-control {
        width: 100%;
        padding: 10px 12px;
        border: 1px solid var(--border-color);
        border-radius: 6px;
        font-family: inherit;
        font-size: 0.95rem;
        transition: all 0.3s ease;
        box-sizing: border-box;
    }

    .form-control:focus {
        outline: none;
        border-color: var(--primary-color);
        box-shadow: 0 0 0 3px rgba(42, 82, 152, 0.1);
    }

    .form-error {
        font-size: 0.8rem;
        color: var(--danger-color);
        margin-top: 4px;
        display: block;
    }

    .field-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    textarea.form-control {
        resize: vertical;
        min-height: 100px;
    }

    .info-box {
        background: #e3f2fd;
        border-left: 4px solid var(--info-color);
        padding: 16px;
        border-radius: 6px;
        margin-bottom: 20px;
        font-size: 0.9rem;
        color: #1565c0;
    }

    .info-box strong {
        color: var(--text-primary);
    }

    .button-group {
        display: flex;
        gap: 12px;
        margin-top: 24px;
    }

    .submit-button {
        background: var(--primary-color);
        color: white;
        padding: 12px 24px;
        border: none;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        font-size: 0.95rem;
    }

    .submit-button:hover {
        background: #1e3e7d;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(42, 82, 152, 0.3);
    }

    .cancel-button {
        background: var(--text-secondary);
        color: white;
        padding: 12px 24px;
        border: none;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        font-size: 0.95rem;
        text-decoration: none;
        display: inline-block;
    }

    .cancel-button:hover {
        background: #555;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(127, 140, 141, 0.3);
    }

    .workflow-card {
        background: white;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        overflow: hidden;
    }

    .workflow-header {
        background: var(--light-bg);
        border-bottom: 2px solid var(--border-color);
        padding: 16px 20px;
        font-weight: 600;
        color: var(--text-primary);
    }

    .workflow-body {
        padding: 20px;
        font-size: 0.9rem;
        color: var(--text-secondary);
    }

    .workflow-step {
        display: flex;
        align-items: center;
        margin-bottom: 16px;
        position: relative;
    }

    .workflow-step:last-child {
        margin-bottom: 0;
    }

    .step-dot {
        width: 10px;
        height: 10px;
        background: var(--primary-color);
        border-radius: 50%;
        margin-right: 12px;
        flex-shrink: 0;
    }

    .step-content {
        flex: 1;
    }

    .step-title {
        font-weight: 600;
        color: var(--text-primary);
        font-size: 0.9rem;
    }

    .step-desc {
        font-size: 0.8rem;
        color: var(--text-secondary);
        margin-top: 2px;
    }

    @media (max-width: 1024px) {
        .create-layout {
            grid-template-columns: 1fr;
        }

        .field-grid {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 768px) {
        .create-page-title {
            font-size: 1.5rem;
        }

        .button-group {
            flex-direction: column;
        }

        .submit-button,
        .cancel-button {
            width: 100%;
        }
    }
</style>

<h1 class="create-page-title">✚ Créer une nouvelle action</h1>

<div class="create-layout">
    <form asp-action="Create" method="post">
        <div class="form-card">
            <div class="form-group">
                <label asp-for="Reference" class="form-label">Référence *</label>
                <input asp-for="Reference" class="form-control" placeholder="ACT-2026-001" required />
                <span asp-validation-for="Reference" class="form-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Title" class="form-label">Intitulé *</label>
                <input asp-for="Title" class="form-control" placeholder="Titre de l'action" required />
                <span asp-validation-for="Title" class="form-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description" class="form-label">Description</label>
                <textarea asp-for="Description" class="form-control" placeholder="Détails et contexte de l'action..."></textarea>
                <span asp-validation-for="Description" class="form-error"></span>
            </div>

            <div class="field-grid">
                <div class="form-group">
                    <label asp-for="Priority" class="form-label">Priorité *</label>
                    <select asp-for="Priority" class="form-control" required>
                        <option value="">-- Sélectionner --</option>
                        <option value="0">Basse</option>
                        <option value="1" selected>Moyenne</option>
                        <option value="2">Haute</option>
                        <option value="3">Critique</option>
                    </select>
                    <span asp-validation-for="Priority" class="form-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="ResponsibleId" class="form-label">Responsable *</label>
                    <select asp-for="ResponsibleId" class="form-control" required>
                        <option value="">-- Sélectionner --</option>
                        @foreach (var user in responsibles)
                        {
                            <option value="@user.Id">@user.FullName</option>
                        }
                    </select>
                    <span asp-validation-for="ResponsibleId" class="form-error"></span>
                </div>
            </div>

            <div class="field-grid">
                <div class="form-group">
                    <label asp-for="StartDate" class="form-label">Date de début *</label>
                    <input asp-for="StartDate" class="form-control" type="date" required />
                    <span asp-validation-for="StartDate" class="form-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="DueDate" class="form-label">Date d'échéance *</label>
                    <input asp-for="DueDate" class="form-control" type="date" required />
                    <span asp-validation-for="DueDate" class="form-error"></span>
                </div>
            </div>

            <input type="hidden" asp-for="ActionPlanId" />

            <div class="info-box">
                ℹ️ <strong>Information:</strong> L'action sera créée en <strong>Brouillon</strong> et devra être transmise au responsable.
            </div>

            <div class="button-group">
                <button type="submit" class="submit-button">✓ Créer l'action</button>
                <a asp-action="Index" asp-route-planId="@Model.ActionPlanId" class="cancel-button">✕ Annuler</a>
            </div>
        </div>
    </form>

    <div class="workflow-card">
        <div class="workflow-header">🔄 Workflow de l'action</div>
        <div class="workflow-body">
            <div class="workflow-step">
                <div class="step-dot"></div>
                <div class="step-content">
                    <div class="step-title">🔨 Brouillon</div>
                    <div class="step-desc">Création</div>
                </div>
            </div>
            <div class="workflow-step">
                <div class="step-dot"></div>
                <div class="step-content">
                    <div class="step-title">🔵 Nouvelle</div>
                    <div class="step-desc">Transmission</div>
                </div>
            </div>
            <div class="workflow-step">
                <div class="step-dot"></div>
                <div class="step-content">
                    <div class="step-title">✓ Acceptée</div>
                    <div class="step-desc">Responsable accepte</div>
                </div>
            </div>
            <div class="workflow-step">
                <div class="step-dot"></div>
                <div class="step-content">
                    <div class="step-title">📎 Preuve soumise</div>
                    <div class="step-desc">Justification fournie</div>
                </div>
            </div>
            <div class="workflow-step">
                <div class="step-dot"></div>
                <div class="step-content">
                    <div class="step-title">✓✓ Complétée</div>
                    <div class="step-desc">Preuve validée</div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
